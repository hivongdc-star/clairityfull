# ==== REQUIRED ====
DATABASE_URL=postgresql://postgres.ejlzkrwrymhdtvtrbvmk:<DB_PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
GEMINI_API_KEY=REPLACE_ME

# JWT access secret (dài và ngẫu nhiên)
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# ==== OPTIONAL (có default) ====
HOST=0.0.0.0
PORT=5000

# Cookie cho refresh token
REFRESH_COOKIE_NAME=clairity_rt
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Access token TTL (giây)
ACCESS_TOKEN_TTL_SECONDS=900

# Gemini model
GEMINI_MODEL=gemini-2.0-flash

# Giới hạn input để tránh lỗi / chi phí
MAX_INPUT_CHARS=8000

# Cho phép CORS khi chạy dev (danh sách phân tách bằng dấu phẩy). Production qua Nginx thường không cần.
ALLOWED_ORIGINS=http://localhost:5173
